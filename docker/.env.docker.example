# ============================================================
# JobDevs - Variables de Entorno para Docker
# ============================================================
# IMPORTANTE: Copia este archivo como .env en la raíz del
# proyecto y cambia las contraseñas antes de usar en producción.
#
# Uso: cp docker/.env.docker.example .env
# ============================================================

# ---- Django ----
DJANGO_SECRET_KEY=CHANGE_ME__GENERATE_A_REAL_SECRET_KEY
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# ---- Base de Datos PostgreSQL ----
DB_ENGINE=django.db.backends.postgresql
DB_NAME=teir_db
DB_USER=teir_user
DB_PASSWORD=CHANGE_ME__SET_A_REAL_PASSWORD
DB_HOST=db
DB_PORT=5432

